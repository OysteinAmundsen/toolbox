---
// ResponsiveDefaultDemo.astro — the playground for every single-breakpoint option.
import DemoControls from '@components/DemoControls.astro';
---
<div class="grid-demo not-content" id="responsive-default-demo">
  <DemoControls controls={[
    { section: 'LAYOUT', name: 'mode', label: 'Mode', type: 'radio',
      options: ['auto', 'table', 'card'], default: 'auto',
      description: 'Auto follows the breakpoint; table/card force it via setResponsive()' },
    { section: 'LAYOUT', name: 'breakpoint', label: 'Breakpoint (px)', type: 'number',
      min: 200, max: 1000, step: 50, default: 500, description: 'Card layout applies below this width' },
    { section: 'LAYOUT', name: 'debounceMs', label: 'Debounce (ms)', type: 'number',
      min: 0, max: 500, step: 50, default: 100, description: 'Minimum interval between layout switches' },
    { section: 'CARD', name: 'hideHeader', label: 'Hide field labels', type: 'boolean',
      default: false, description: 'Drop the per-card "Name:" prefix' },
    { section: 'CARD', name: 'hiddenColumns', label: 'Hidden columns', type: 'check-group',
      options: ['email', 'startDate', 'salary'], default: [], description: 'Columns to drop in card mode' },
    { section: 'CARD', name: 'hiddenStyle', label: 'Hidden column style', type: 'radio',
      options: ['hide', 'value only'], default: 'hide',
      description: 'Remove the cell entirely, or keep the value without its label' },
    { section: 'MOTION', name: 'animation', label: 'Animation', type: 'radio',
      options: ['off', 'fade', 'morph-rows', 'morph-cells'], default: 'fade',
      description: 'Cross-fade the grid, or travel each row — or each cell — into place' },
    { section: 'MOTION', name: 'animationDuration', label: 'Duration (ms)', type: 'number',
      min: 50, max: 800, step: 50, default: 200 },
  ]} />
  <div class="responsive-instruction">↔ Drag the right edge to resize the container</div>
  <div class="responsive-resize-wrap">
    <tbw-grid style="height: 350px;"></tbw-grid>
    <div class="responsive-status"></div>
  </div>
  <div class="log-panel">
    <div class="log-header">
      <strong>responsive-change log</strong>
      <button type="button" id="responsive-default-clear">Clear</button>
    </div>
    <div class="event-log" id="responsive-default-log"></div>
  </div>
</div>

<style>
  #responsive-default-demo .responsive-instruction {
    margin-bottom: 8px;
    padding: 0 8px;
    color: var(--sl-color-gray-3);
    font-size: 14px;
  }
  #responsive-default-demo .responsive-resize-wrap {
    resize: horizontal;
    overflow: auto;
    width: 700px;
    min-width: 250px;
    max-width: 100%;
    border: 2px dashed var(--sl-color-gray-5);
    padding: 8px;
  }
  #responsive-default-demo .responsive-status {
    margin-top: 8px;
    font-size: 12px;
    color: var(--sl-color-gray-3);
  }
  #responsive-default-demo .log-panel {
    margin-top: 8px;
    padding: 12px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
    background: var(--sl-color-gray-6);
    max-height: 160px;
    overflow-y: auto;
  }
  #responsive-default-demo .log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  #responsive-default-demo .log-header button {
    padding: 4px 8px;
    cursor: pointer;
    font-size: 12px;
  }
  #responsive-default-demo .event-log {
    font-family: monospace;
    font-size: 11px;
    color: var(--sl-color-gray-2);
  }
  #responsive-default-demo .event-log > div {
    padding: 2px 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  #responsive-default-demo .event-log .event-type {
    color: var(--sl-color-accent);
  }
</style>

<script>
import '@toolbox-web/grid';
import { queryGrid } from '@toolbox-web/grid';
import '@toolbox-web/grid/features/responsive';

const container = document.getElementById('responsive-default-demo');
if (container) {
  const sampleData = [
    { id: 1, name: 'Alice Johnson', department: 'Engineering', salary: 95000, email: 'alice@example.com', startDate: '2020-03-15' },
    { id: 2, name: 'Bob Smith', department: 'Marketing', salary: 75000, email: 'bob@example.com', startDate: '2019-07-22' },
    { id: 3, name: 'Carol Williams', department: 'Engineering', salary: 105000, email: 'carol@example.com', startDate: '2018-11-01' },
    { id: 4, name: 'Dan Brown', department: 'Sales', salary: 85000, email: 'dan@example.com', startDate: '2021-01-10' },
    { id: 5, name: 'Eve Davis', department: 'Marketing', salary: 72000, email: 'eve@example.com', startDate: '2022-05-03' },
    { id: 6, name: 'Frank Miller', department: 'Engineering', salary: 98000, email: 'frank@example.com', startDate: '2020-08-20' },
  ];
  const columns = [
    { field: 'id', header: 'ID', type: 'number', width: 60 },
    { field: 'name', header: 'Name', width: 150 },
    { field: 'department', header: 'Department', width: 120 },
    { field: 'salary', header: 'Salary', type: 'number', width: 100 },
    { field: 'email', header: 'Email', width: 200 },
    { field: 'startDate', header: 'Start Date', width: 120 },
  ];

  const grid = queryGrid('tbw-grid', container)!;
  const status = container.querySelector('.responsive-status')!;
  const log = container.querySelector('#responsive-default-log')!;
  container.querySelector('#responsive-default-clear')!.addEventListener('click', () => (log.innerHTML = ''));

  interface Values {
    mode: string;
    breakpoint: number;
    debounceMs: number;
    hideHeader: boolean;
    hiddenColumns: string[];
    hiddenStyle: string;
    animation: string;
    animationDuration: number;
  }

  let current: Values = {
    mode: 'auto', breakpoint: 500, debounceMs: 100, hideHeader: false, hiddenColumns: [],
    hiddenStyle: 'hide', animation: 'fade', animationDuration: 200,
  };

  function apply(v: Values) {
    current = v;
    grid.gridConfig = {
      columns,
      features: {
        responsive: {
          breakpoint: v.breakpoint,
          debounceMs: v.debounceMs,
          hideHeader: v.hideHeader,
          hiddenColumns:
            v.hiddenStyle === 'value only'
              ? v.hiddenColumns.map((field) => ({ field, showValue: true }))
              : v.hiddenColumns,
          animation: v.animation === 'off' ? false : v.animation,
          animationDuration: v.animationDuration,
        },
      },
    };
    grid.rows = sampleData;

    requestAnimationFrame(() => {
      forceMode();
      render();
    });
  }

  /**
   * Forcing a mode is a plugin-API call, not config — and a `gridConfig` rebuild
   * detaches and re-attaches the plugin, whose ResizeObserver then re-evaluates
   * the breakpoint and undoes the override. So re-assert it from the
   * `responsive-change` handler too; the loop settles after one correction.
   */
  function forceMode() {
    if (current.mode === 'auto') return;
    const want = current.mode === 'card';
    const plugin = grid.getPluginByName('responsive');
    if (plugin && plugin.isResponsive() !== want) plugin.setResponsive(want);
  }

  function render() {
    const plugin = grid.getPluginByName('responsive');
    const isCard = plugin?.isResponsive() ?? false;
    const width = Math.round(plugin?.getWidth() ?? grid.clientWidth);
    const forced = current.mode === 'auto' ? '' : ` | forced via setResponsive(${current.mode === 'card'})`;
    status.textContent = `Mode: ${isCard ? '📱 Card' : '📊 Table'} | Width: ${width}px | Breakpoint: ${current.breakpoint}px${forced}`;
  }

  apply(current);

  container.addEventListener('control-change', ((e: CustomEvent) => apply(e.detail.allValues as Values)) as EventListener);

  grid.on('responsive-change', ({ isResponsive, width, breakpoint }) => {
    const entry = document.createElement('div');
    entry.innerHTML =
      `<span class="event-type">[responsive-change]</span> isResponsive: ${isResponsive}, ` +
      `width: ${Math.round(width)}px, breakpoint: ${breakpoint}px`;
    log.insertBefore(entry, log.firstChild);
    while (log.children.length > 15) log.lastChild?.remove();
    forceMode();
    render();
  });
}
</script>
