---
// ClipboardDefaultDemo.astro
import DemoControls from '@components/DemoControls.astro';
---
<div class="grid-demo not-content" id="clipboard-default-demo">
  <DemoControls controls={[
    { section: 'CLIPBOARD', name: 'includeHeaders', label: 'Include headers', type: 'boolean',
      default: false, description: 'Include column headers when copying' },
    { section: 'CLIPBOARD', name: 'quoteStrings', label: 'Quote strings', type: 'boolean',
      default: false, description: 'Wrap string values in quotes' },
  ]} />
  <tbw-grid id="demo-clipboard-default" style="height: 350px;"></tbw-grid>
  <div class="external-clipboard-wrap">
    <label for="clipboard-external-target">External Clipboard Target</label>
    <textarea
      id="clipboard-external-target"
      placeholder="Click here and press Ctrl+V to paste clipboard data outside the grid"
    ></textarea>
  </div>
</div>

<style>
  .external-clipboard-wrap {
    margin-top: 12px;
    padding: 10px 12px;
    background: light-dark(rgba(246, 247, 249, 0.96), var(--sl-color-gray-6));
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
  }

  .external-clipboard-wrap label {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .external-clipboard-wrap textarea {
    display: block;
    width: 100%;
    min-height: 86px;
    resize: vertical;
    font: 13px/1.35 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg);
    padding: 10px;
  }
</style>

<script>
import '@toolbox-web/grid';
import { queryGrid } from '@toolbox-web/grid';
import '@toolbox-web/grid/features/clipboard';
import '@toolbox-web/grid/features/editing';
import '@toolbox-web/grid/features/selection';

const container = document.getElementById('clipboard-default-demo');
if (container) {
  const sampleData = [
    { id: 1, name: 'Alice', email: 'alice@example.com', department: 'Engineering' },
    { id: 2, name: 'Bob', email: 'bob@example.com', department: 'Marketing' },
    { id: 3, name: 'Carol', email: 'carol@example.com', department: 'Engineering' },
    { id: 4, name: 'Dan', email: 'dan@example.com', department: 'Sales' },
  ];
  const columns = [
    { field: 'id', header: 'ID', type: 'number' },
    { field: 'name', header: 'Name', editable: true },
    { field: 'email', header: 'Email', editable: true },
    { field: 'department', header: 'Department', editable: true },
  ];

  const grid = queryGrid('tbw-grid', container)!;

  function rebuild(includeHeaders = false, quoteStrings = false) {
    grid.gridConfig = {
      columns,
      features: {
        selection: 'range',
        clipboard: { includeHeaders, quoteStrings },
        editing: true,
      },
    };
    grid.rows = sampleData;
  }

  rebuild();

  container.addEventListener('control-change', ((e: CustomEvent) => {
    const v = e.detail.allValues;
    rebuild(v.includeHeaders as boolean, v.quoteStrings as boolean);
  }) as EventListener);
}
</script>
