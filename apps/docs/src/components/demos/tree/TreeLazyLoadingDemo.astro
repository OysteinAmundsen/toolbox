---
// TreeLazyLoadingDemo.astro — Server-Side + Tree demo
import DemoControls from '@components/DemoControls.astro';
---
<div class="grid-demo not-content" id="tree-lazy-loading-demo">
  <DemoControls controls={[
    { section: 'SERVER', name: 'pageSize', label: 'Page size', type: 'number',
      min: 10, max: 100, step: 10, default: 20, description: 'Top-level nodes fetched per request' },
    { section: 'SERVER', name: 'latency', label: 'Latency (ms)', type: 'number',
      min: 0, max: 2000, step: 100, default: 400, description: 'Simulated round-trip for both callbacks' },
    { section: 'TREE', name: 'animation', label: 'Animation', type: 'select',
      options: ['slide', 'fade', 'false'], default: 'slide', description: 'Expand/collapse animation' },
  ]} />
  <tbw-grid style="height: 400px;"></tbw-grid>
  <p class="load-status" style="margin-top: 0.5rem; font-size: 0.85em; color: var(--sl-color-gray-3);">
    Scroll to load more nodes — expand a team to fetch its members.
  </p>
</div>

<script>
import '@toolbox-web/grid';
import { queryGrid } from '@toolbox-web/grid';
import '@toolbox-web/grid/features/server-side';
import '@toolbox-web/grid/features/tree';

const container = document.getElementById('tree-lazy-loading-demo');
if (container) {
  const statusEl = container.querySelector('.load-status')!;

  const DEPARTMENTS = ['Engineering', 'Marketing', 'Sales', 'HR', 'Finance'];
  const TOTAL_NODES = 200;

  // `children: true` marks a node whose children are not loaded yet — that is
  // what makes the grid render an expand toggle before any child data exists.
  function makeNode(i: number) {
    const dept = DEPARTMENTS[i % DEPARTMENTS.length];
    return {
      id: `${i + 1}`,
      name: `${dept} Team ${Math.floor(i / DEPARTMENTS.length) + 1}`,
      role: 'Manager',
      department: dept,
      children: true,
    };
  }

  const allTopLevelNodes = Array.from({ length: TOTAL_NODES }, (_, i) => makeNode(i));

  function makeMembers(node: { id: string; department: string }) {
    const teamSize = 2 + (Number(node.id) % 4);
    return Array.from({ length: teamSize }, (_, j) => ({
      id: `${node.id}-${j + 1}`,
      name: `${node.department} Member ${j + 1}`,
      role: j === 0 ? 'Lead' : 'Member',
      department: node.department,
    }));
  }

  const delay = (ms: number, signal?: AbortSignal) =>
    new Promise<void>((resolve, reject) => {
      const timer = setTimeout(resolve, ms);
      signal?.addEventListener('abort', () => {
        clearTimeout(timer);
        reject(new DOMException('Aborted', 'AbortError'));
      });
    });

  // Simulated server: `getRows` pages the top-level nodes, `getChildRows`
  // resolves one node's children the first time it is expanded.
  function createDataSource(latency: number) {
    return {
      async getRows(params: any) {
        await delay(latency, params.signal);

        const data = [...allTopLevelNodes];
        if (params.sortModel?.length) {
          const { field, direction } = params.sortModel[0];
          data.sort((a: any, b: any) => {
            const cmp = a[field] < b[field] ? -1 : a[field] > b[field] ? 1 : 0;
            return direction === 'asc' ? cmp : -cmp;
          });
        }

        return {
          rows: data.slice(params.startNode, params.endNode),
          totalNodeCount: data.length,
        };
      },

      async getChildRows(params: any) {
        await delay(latency);
        return { rows: makeMembers(params.context.parentNode) };
      },
    };
  }

  const columns = [
    { field: 'name', header: 'Name', sortable: true },
    { field: 'role', header: 'Role' },
    { field: 'department', header: 'Department', sortable: true },
  ];

  const grid = queryGrid('tbw-grid', container)!;

  function rebuild(opts: Record<string, unknown>) {
    const pageSize = (opts.pageSize as number) ?? 20;
    const latency = (opts.latency as number) ?? 400;

    grid.gridConfig = {
      columns,
      features: {
        serverSide: { pageSize },
        tree: {
          childrenField: 'children',
          animation: opts.animation === 'false' ? false : (opts.animation as string) ?? 'slide',
        },
      },
    };

    grid.ready().then(() => {
      grid.getPluginByName('serverSide')?.setDataSource(createDataSource(latency));
    });
  }

  rebuild({ pageSize: 20, latency: 400, animation: 'slide' });

  grid.on('datasource:loading' as any, (e: any) => {
    if (e.detail?.loading) {
      statusEl.textContent = e.detail.context?.source === 'tree' ? 'Loading team members…' : 'Loading nodes…';
      return;
    }
    // The row model is rebuilt on the next render — wait for it before counting.
    grid.ready().then(() => {
      const serverSide = grid.getPluginByName('serverSide') as any;
      const tree = grid.getPluginByName('tree') as any;
      const visible = tree?.getFlattenedRows?.()?.length ?? 0;
      const total = serverSide?.getTotalNodeCount?.() ?? 0;
      statusEl.textContent = `${visible} rows shown · ${total} top-level nodes on the server`;
    });
  });

  container.addEventListener('control-change', ((e: CustomEvent) => {
    rebuild(e.detail.allValues);
  }) as EventListener);
}
</script>
