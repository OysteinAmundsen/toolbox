{
  "name": "grid",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/grid/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:grid", "layer:core"],
  "targets": {
    "typecheck": {
      "command": "bunx tsc -p libs/grid/tsconfig.lib.json --noEmit",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/libs/grid"],
      "defaultConfiguration": "production",
      "dependsOn": ["typecheck"],
      "options": {
        "emptyOutDir": true,
        "outDir": "../../dist/libs/grid"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/grid"],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/libs/grid"
      }
    },
    "typedoc": {
      "command": "bunx typedoc --options typedoc.json && bun run scripts/typedoc-to-mdx.ts",
      "inputs": ["{projectRoot}/src/**/*.ts", "{projectRoot}/typedoc.json", "{projectRoot}/scripts/typedoc-to-mdx.ts"],
      "outputs": [
        "{projectRoot}/docs/api-generated",
        "{workspaceRoot}/apps/docs/src/content/docs/grid/api",
        "{workspaceRoot}/apps/docs/src/content/docs/grid/plugins/**/api"
      ],
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "bench": {
      "command": "vitest bench --config libs/grid/vite.config.ts --run",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    }
  }
}
